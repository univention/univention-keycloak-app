version: '3.1'

services:
  keycloak:
    container_name: keycloak
    # Published image from the pipeline: public "nubus" project on a release,
    # private "nubus-dev" otherwise. The RELEASE_VERSION tag is kept as a readable
    # label; the content digest (exported by the update_appcenter job from the
    # build artifact) is appended to pin the exact image. Docker pulls by digest
    # when both are present. No digest (no image built this pipeline) -> tag only.
    image: {{ EXTERNAL_PUBLIC_IMAGE_REGISTRY if PUBLIC_RELEASE else EXTERNAL_PRIVATE_IMAGE_REGISTRY }}/keycloak:{{ RELEASE_VERSION }}{{ ('@' ~ KEYCLOAK_IMAGE_DIGEST) if KEYCLOAK_IMAGE_DIGEST else '' }}
    # For --proxy=edge see https://www.keycloak.org/server/reverseproxy
    # For --hostname   see https://www.keycloak.org/server/hostname
@!@
ucr = configRegistry
kc_fqdn = ucr.get('keycloak/server/sso/fqdn').lower()
sso_path = ucr.get('keycloak/server/sso/path', '/').rstrip('/')
# --http-relative-path= needs to have a value, always
if not sso_path:
    sso_path = '/'
db_kind = ucr.get('kc/db/kind')
db_xa = ucr.get('kc/db/xa')
command = f"start --hostname={kc_fqdn} --http-relative-path={sso_path} --http-enabled=true --proxy-headers xforwarded --cache-config-file=cache-ispn-jdbc-ping.xml --db={db_kind} --transaction-xa-enabled={db_xa} --health-enabled=true --metrics-enabled=true"

#################
# optional args #
#################

# themeing cache
if ucr.is_true("keycloak/disable/theme/caching", False):
    command = f"{command} --spi-theme-static-max-age=-1 --spi-theme-cache-themes=false --spi-theme-cache-templates=false"

# ssf features
if ucr.is_true("keycloak/server/feature/ssf", False):
    command = f"{command} --feature-ssf=enabled"

# Optional metrics tuning (Bug #58175). All endpoints stay disabled by default;
# the flags below are only emitted when the corresponding UCR variable is set.
if ucr.is_true("keycloak/http/metrics/histograms/enabled", False):
    command = f"{command} --http-metrics-histograms-enabled=true"
slos = ucr.get("keycloak/http/metrics/slos")
if slos:
    command = f"{command} --http-metrics-slos={slos}"
if ucr.is_true("keycloak/event/metrics/user/enabled", False):
    command = f"{command} --feature-user-event-metrics enabled --event-metrics-user-enabled=true"
    user_tags = ucr.get("keycloak/event/metrics/user/tags")
    if user_tags:
        command = f"{command} --event-metrics-user-tags={user_tags}"
    user_events = ucr.get("keycloak/event/metrics/user/events")
    if user_events:
        command = f"{command} --event-metrics-user-events={user_events}"

print(f"    command: {command}")

@!@
    # see https://forge.univention.org/bugzilla/show_bug.cgi?id=55360
    security_opt:
      - seccomp:/etc/docker/seccomp-systemd.json
    restart: unless-stopped
    environment:
      KC_HTTP_PORT: "8180"
      JGROUPS_DISCOVERY_EXTERNAL_IP: @%@hostname@%@.@%@domainname@%@
      KC_HTTPS_KEY_STORE_PASSWORD: univention
      KEYCLOAK_ADMIN: admin
      JAVA_OPTS_APPEND: @!@
ucr = configRegistry
java_opts = ucr.get('keycloak/java/opts/append', '')
print(java_opts)@!@
      KEYCLOAK_ADMIN_PASSWORD: @!@
import os
pwdfile="/etc/keycloak.secret"
with open(pwdfile, 'r') as fd:
    print(fd.read().strip())@!@
      KC_LOG_LEVEL: @%@keycloak/log/level@%@
      KC_SPI_EVENTS_LISTENER__JBOSS_LOGGING__SUCCESS_LEVEL: @%@keycloak/audit/events/success/level@%@
      KC_SPI_EVENTS_LISTENER__JBOSS_LOGGING__ERROR_LEVEL: @%@keycloak/audit/events/error/level@%@
      PROXY_ADDRESS_FORWARDING: "true"
      X509_CA_BUNDLE: "/ca-certificates.crt"
    volumes:
      - /etc/ssl/certs/ca-certificates.crt:/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:ro
      - /etc/univention/ssl/ucsCA/CAcert.pem:/etc/pki/ca-trust/extracted/pem/ucsCAcert.pem:ro
      - /var/lib/univention-appcenter/apps/keycloak/conf/UCS/login/messages/:/opt/keycloak/themes/UCS/login/messages/:ro
      #- /var/lib/univention-appcenter/apps/keycloak/data/development:/opt/jboss/keycloak/standalone/deployments/
    deploy:
      resources:
        limits:
          memory: @%@keycloak/deploy/resources/limits/memory@%@
    ports:
      # does not work, see https://forge.univention.org/bugzilla/show_bug.cgi?id=53878
      # - 127.0.0.1:8180:8080
      - 8180:8180
      - 7600:7600
      # Keycloak management port (health + metrics endpoints), Bug #58175.
      # Opt-in: not published by default. Set keycloak/management/port to a port
      # number (e.g. 9000) to publish it on the host; leave it empty/unset to
      # keep the endpoints reachable only inside the container or via a reverse
      # proxy (keycloak-observability-proxy). Reachable only where the firewall permits.
@!@
mgmt_port = configRegistry.get('keycloak/management/port', '').strip()
if mgmt_port:
    print(f'      - {mgmt_port}:9000')
@!@
    healthcheck:
      test: /opt/keycloak/bin/keycloak-healthcheck || exit 1
      interval: "2s"
      timeout: "5s"
      retries: 30
